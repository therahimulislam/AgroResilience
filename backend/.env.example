# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agroresilience

# ─── Auth ─────────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── Intelligence Provider Mode ───────────────────────────────────────────────
# Options: demo | real
PROVIDER_MODE=demo

# ─── Google Gemini ────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Frontend (set these in frontend/.env) ────────────────────────────────────
VITE_API_URL=http://localhost:8000/api/v1
